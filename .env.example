# ==============================================================================
# Hyper-RAG Runtime Configuration
# Copy this file to .env and fill in your API credentials:
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows cmd)
#   Copy-Item .env.example .env (Windows PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY LLM PROVIDER (OpenRouter)
# Required for text generation, query answers, and hypergraph reasoning.
# Supports a single key or comma-separated keys for automatic round-robin rotation.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional multiple keys for rotation:
# OPENROUTER_API_KEYS=key1,key2,key3
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ------------------------------------------------------------------------------
# 2. EMBEDDING PROVIDER (Mistral)
# Required for 1024-dimensional vector indexing and dense retrieval.
# Supports a single key or comma-separated keys for automatic round-robin rotation.
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=your_mistral_api_key_here
# Optional aliases:
# EMB_API_KEY=your_mistral_api_key_here
# EMB_API_KEYS=key1,key2,key3
EMB_BASE_URL=https://api.mistral.ai/v1
EMB_MODEL=mistral-embed
EMB_DIM=1024

# ------------------------------------------------------------------------------
# 3. WEB APPLICATION SERVER
# Network host, port, and default knowledge base selection.
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEFAULT_DATABASE=mock

# ------------------------------------------------------------------------------
# 4. INGESTION & UPLOAD LIMITS
# Safety limits to prevent accidental resource exhaustion during indexing.
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
MAX_RECORDS=1000

# ------------------------------------------------------------------------------
# 5. ADAPTIVE HYPER-RAG ROUTING & SUFFICIENCY
# Controls dynamic mode escalation (Lite -> Core -> Fallback) and sufficiency checks.
# ------------------------------------------------------------------------------
ADAPTIVE_RAG_ENABLED=true
ADAPTIVE_RAG_MODE=adaptive
ADAPTIVE_CORE_THRESHOLD=60
ADAPTIVE_RETRIEVAL_SUFFICIENCY_ENABLED=true
ADAPTIVE_RETRIEVAL_SUFFICIENCY_THRESHOLD=60
ADAPTIVE_LOG_DECISIONS=true
ADAPTIVE_SHORT_QUERY_MAX_WORDS=7
ADAPTIVE_SHORT_QUERY_DENSITY_BONUS=15.0

# ------------------------------------------------------------------------------
# 6. RESPONSE VALIDATION (PHASE 3)
# Validates generated answers against retrieved evidence before returning.
# ------------------------------------------------------------------------------
ADAPTIVE_VALIDATION_ENABLED=true
ADAPTIVE_VALIDATION_THRESHOLD=70.0
ADAPTIVE_VALIDATION_LOG_DECISIONS=true
ADAPTIVE_VALIDATION_COMPLETENESS_WEIGHT=0.40
ADAPTIVE_VALIDATION_EVIDENCE_WEIGHT=0.40
ADAPTIVE_VALIDATION_RELEVANCE_WEIGHT=0.20
